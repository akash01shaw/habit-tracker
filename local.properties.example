# Copy this file to "local.properties" (same folder) and fill in real values.
# local.properties is gitignored — never commit real keys.

sdk.dir=C\:\\Users\\akash\\AppData\\Local\\Android\\Sdk

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Google Sign-In: OAuth 2.0 "Web application" client ID (NOT the Android client ID)
# created in Google Cloud Console, and also registered as the Google provider's
# "Client ID" in Supabase Auth settings (Authentication -> Providers -> Google).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
